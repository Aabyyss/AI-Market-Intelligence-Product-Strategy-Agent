{
  "name": "Market Intel — corpus refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 24, "triggerAtHour": 6 }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Daily 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-api",
              "name": "api_base",
              "value": "={{ $env.MARKET_INTEL_API_BASE || 'http://127.0.0.1:8000' }}",
              "type": "string"
            },
            {
              "id": "cfg-limit",
              "name": "limit",
              "value": "={{ Number($env.MARKET_INTEL_FETCH_LIMIT || 25) }}",
              "type": "number"
            },
            {
              "id": "cfg-max",
              "name": "max_attempts",
              "value": "={{ Number($env.MARKET_INTEL_MAX_POLLS || 60) }}",
              "type": "number"
            },
            {
              "id": "cfg-wait",
              "name": "poll_seconds",
              "value": "={{ Number($env.MARKET_INTEL_REFRESH_POLL_SECONDS || 20) }}",
              "type": "number"
            },
            {
              "id": "cfg-slack",
              "name": "slack_webhook",
              "value": "={{ $env.SLACK_WEBHOOK_URL || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base }}/pipeline/refresh",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ limit: $json.limit, reindex: true }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Start refresh job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst job = $input.first().json;\nreturn [{ json: { ...cfg, job_id: job.job_id, status: job.status, attempt: 0 } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Init state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "amount": "={{ $json.poll_seconds }}",
        "unit": "seconds"
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [740, 160],
      "webhookId": "ba1c6a1e-0002-4000-8000-000000000005"
    },
    {
      "parameters": {
        "url": "={{ $json.api_base }}/jobs/{{ $json.job_id }}",
        "options": { "timeout": 30000 }
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Poll job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst item = $input.first().json;\nconst status = item.status || 'unknown';\n\nif (status === 'failed') {\n  return [{ json: { ...item, route: 'failed', error: item.error || 'job failed' } }];\n}\nif (status === 'queued' || status === 'running') {\n  const attempt = (item.attempt || 0) + 1;\n  if (attempt >= cfg.max_attempts) {\n    return [{ json: { ...item, route: 'timeout', error: `still ${status} after ${attempt} polls` } }];\n  }\n  return [{ json: { ...item, attempt, route: 'wait' } }];\n}\nreturn [{ json: { ...item, route: 'done' } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-wait",
              "leftValue": "={{ $json.route }}",
              "rightValue": "wait",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1400, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-failed",
              "leftValue": "={{ $json.route }}",
              "rightValue": "done",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1620, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The refresh is silent unless something actually changed — a daily\n// \"0 new posts\" ping trains people to ignore the channel.\nconst cfg = $('Config').first().json;\nconst item = $input.first().json;\nconst r = item.result || {};\nconst lines = [\n  `:inbox_tray: *Corpus refreshed* — ${r.inserted || 0} new posts (${r.posts_total || 0} total)`,\n  `Queries: ${r.queries || 0} | kept: ${r.kept || 0} | indexed chunks: ${r.chunks ?? 'n/a'}`\n];\nreturn [{ json: { ...cfg, slack_text: lines.join('\\n'), changed: (r.inserted || 0) > 0 } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "Format success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1840, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst item = $input.first().json;\nreturn [{ json: { ...cfg, changed: true, slack_text: `:x: *Corpus refresh failed* — ${item.error || 'unknown error'}\\nJob: ${cfg.api_base}/jobs/${item.job_id || 'n/a'}` } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000011",
      "name": "Format failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1840, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-slack",
              "leftValue": "={{ $json.slack_webhook }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000012",
      "name": "Slack configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2060, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slack_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.slack_text }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "b2000000-0000-4000-8000-000000000013",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2300, 160]
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-000000000014",
      "name": "No Slack (done)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2300, 300]
    }
  ],
  "connections": {
    "Daily 06:00": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Start refresh job", "type": "main", "index": 0 }]] },
    "Start refresh job": {
      "main": [
        [{ "node": "Init state", "type": "main", "index": 0 }],
        [{ "node": "Format failure", "type": "main", "index": 0 }]
      ]
    },
    "Init state": { "main": [[{ "node": "Wait", "type": "main", "index": 0 }]] },
    "Wait": { "main": [[{ "node": "Poll job", "type": "main", "index": 0 }]] },
    "Poll job": {
      "main": [
        [{ "node": "Route", "type": "main", "index": 0 }],
        [{ "node": "Format failure", "type": "main", "index": 0 }]
      ]
    },
    "Route": { "main": [[{ "node": "Still running?", "type": "main", "index": 0 }]] },
    "Still running?": {
      "main": [
        [{ "node": "Wait", "type": "main", "index": 0 }],
        [{ "node": "Failed?", "type": "main", "index": 0 }]
      ]
    },
    "Failed?": {
      "main": [
        [{ "node": "Format failure", "type": "main", "index": 0 }],
        [{ "node": "Format success", "type": "main", "index": 0 }]
      ]
    },
    "Format success": { "main": [[{ "node": "Slack configured?", "type": "main", "index": 0 }]] },
    "Format failure": { "main": [[{ "node": "Slack configured?", "type": "main", "index": 0 }]] },
    "Slack configured?": {
      "main": [
        [{ "node": "Notify Slack", "type": "main", "index": 0 }],
        [{ "node": "No Slack (done)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "instanceId": "market-intel-demo" },
  "tags": [{ "name": "market-intel" }]
}
