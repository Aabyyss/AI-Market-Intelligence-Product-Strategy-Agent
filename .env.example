# Phase 6: configuration lives in the environment, never in the code.
#
#   cp .env.example .env      # then edit; .env is gitignored
#
# Everything here is optional — the service runs with the defaults below
# (local Ollama, corpus at data/market_intel.db).

# --- storage -----------------------------------------------------------
MARKET_INTEL_DB=data/market_intel.db
MARKET_INTEL_REPORT_DIR=data/reports

# --- service -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Report jobs run one at a time by default: the agent pipeline is
# CPU/GPU-bound, so a second concurrent report only slows the first.
# Raising this only helps with a provider that has spare capacity.
MARKET_INTEL_WORKERS=1
LOG_LEVEL=INFO

# --- LLM provider ------------------------------------------------------
# auto | openai | ollama | custom
#   auto -> OpenAI if OPENAI_API_KEY is set, else Ollama on localhost.
LLM_PROVIDER=auto
# Leave empty to use the provider default (gpt-4o-mini / llama3.2).
LLM_MODEL=

# Ollama, or any OpenAI-compatible server.
# In docker compose this is set to http://ollama:11434/v1 for you.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI (or a compatible gateway) — used only when this is set.
OPENAI_API_KEY=
# For LLM_PROVIDER=custom, e.g. https://my-gateway.example.com/v1
OPENAI_BASE_URL=

# --- embeddings --------------------------------------------------------
# Where fastembed caches the bge-small model. Empty = library default.
# The Docker image sets this to /opt/fastembed.
FASTEMBED_CACHE_DIR=

# --- evaluation --------------------------------------------------------
# Labeled question set for POST /eval.
MARKET_INTEL_EVAL_QUESTIONS=tests/fixtures/eval_questions.json

# --- n8n automation layer (see n8n/README.md) ---------------------------
# The workflow Config (Set) nodes read these from the n8n process env via
# $env.* — start n8n with n8n/start_n8n.cmd, which loads this file into
# the n8n process environment.

# Incoming-webhook URL for posting the daily report; empty = skip notify.
# Create one free in Slack: Apps -> Incoming WebHooks -> Add to workspace.
SLACK_WEBHOOK_URL=

# Where the workflows reach the API (host side, not container-side).
MARKET_INTEL_API_BASE=http://127.0.0.1:8000

# Report digest style, e.g. "one paragraph for a busy PM".
MARKET_INTEL_BRIEF=one paragraph for a busy product manager

# Report: evidence chunks retrieved per question.
MARKET_INTEL_PER_QUERY=4

# Corpus refresh: HN hits fetched per query.
MARKET_INTEL_FETCH_LIMIT=25

# Job polling: give up after N polls, waiting POLL_SECONDS between checks
# (report default 40x45s; refresh defaults to its own REFRESH_POLL_SECONDS).
MARKET_INTEL_MAX_POLLS=60
MARKET_INTEL_POLL_SECONDS=30
MARKET_INTEL_REFRESH_POLL_SECONDS=30
